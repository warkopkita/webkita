# ==========================================
# Webkita - Docker Environment Configuration
# ==========================================

APP_NAME="Webkita"
APP_ENV=production
APP_KEY=base64:XG8L6G9p/WbE1YV8PZ5aV5W2R9X0Y2Z3A4B5C6D7E8F=
APP_DEBUG=false
APP_TIMEZONE="Asia/Jakarta"
APP_URL=https://webkita.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Port Mapping (Nginx)
HTTP_PORT=80
HTTPS_PORT=443

# Database (MySQL Container)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=webkita_db
DB_USERNAME=webkita_user
DB_PASSWORD=Secret2026Webkita!
DB_ROOT_PASSWORD=RootSecret2026!

# Cache, Session & Queue (Redis Container)
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Email Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@webkita.id"
MAIL_FROM_NAME="Webkita Studio"

# Midtrans Payment Gateway
# Set MIDTRANS_IS_PRODUCTION=true untuk live payment
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Google OAuth (Opsional, fallback demo lokal aktif jika kosong)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Analytics Tracking (Opsional)
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# WhatsApp Admin Hotline
WHATSAPP_ADMIN_NUMBER="6281234567890"
